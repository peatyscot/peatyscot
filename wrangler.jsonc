{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peatyscot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",

  // Hugo's output. Built by `npm run build` before deploying.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker must see every request to normalise www -> apex and to attach
    // cache and security headers. Without this, assets are served directly and
    // the Worker never runs.
    "run_worker_first": true
  },

  "observability": {
    "enabled": true
  },

  // Both hosts are needed: www must resolve for the Worker's www -> apex
  // redirect to be reachable at all. These create DNS records on the live zone.
  "routes": [
    { "pattern": "peaty.scot", "custom_domain": true },
    { "pattern": "www.peaty.scot", "custom_domain": true }
  ]
}
